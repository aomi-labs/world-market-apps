# World Markets Agent — dev-runtime env (aomi-run)
# Copy to .env and fill in a provider key. .env is git-ignored.

# Hosted chat CLI: ./scripts/hosted-chat.sh
# AOMI_BACKEND_URL=https://chat-staging.aomi.dev
# AOMI_APP=world-markets
# AOMI_PLATFORM=world-market-apps
# AOMI_APPLICATION_ID=
# World account bound via the owner wallet (the hosted app has no WORLD_ACCOUNT_ID).
# WORLD_HOSTED_ACCOUNT_ID=19
# WORLD_OWNER_WALLET=

# OpenRouter (default provider for local testing)
OPENROUTER_API_KEY=

# Local-only chain overrides (defaults target the UniFi testnet). Hosted
# runs take the chain from the host and the exchange from the handover.
# WORLD_RPC_URL=https://testnet-unifi-rpc.puffer.fi/
# WORLD_EXCHANGE_ADDRESS=0xf6b54e033bb45a583aa642924bcef78b804588ae

# Local-only account binding (requires `--features local-dev`, see
# scripts/dev-run.sh). aomi-run stubs the handover, so read-only account
# tools act as the on-chain owner of this account. Never set on a hosted build.
# WORLD_ACCOUNT_ID=17

# Optional PnL ledger directory (realized / closed-position PnL).
# Defaults to $XDG_DATA_HOME/aomi/world-markets/pnl or ~/.local/share/aomi/world-markets/pnl
# WORLD_PNL_DIR=/path/to/pnl-ledger
# Optional loan origination ledger directory (same XDG layout as PnL).
# WORLD_LOAN_DIR=/path/to/loan-origination

# Optional native-yield table (JSON object of symbol → APY decimal string). Missing = null / none.
# WORLD_NATIVE_YIELDS={"WETH":"0.03","SOL":"0.075"}
# WORLD_NATIVE_YIELDS_PATH=/path/to/native-yields.json

# Attach RPC call counts to account tool results.
# WORLD_RPC_TRACE=1
