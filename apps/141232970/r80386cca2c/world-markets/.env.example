# World Markets Agent — dev-runtime env (aomi-run)
# Copy to .env and fill in a provider key. .env is git-ignored.

# OpenRouter (default provider for local testing)
OPENROUTER_API_KEY=

# Optional chain overrides (defaults target the UniFi testnet)
# WORLD_RPC_URL=https://testnet-unifi-rpc.puffer.fi/
# WORLD_EXCHANGE_ADDRESS=0xf6b54e033bb45a583aa642924bcef78b804588ae

# Optional PnL ledger directory (realized / closed-position PnL).
# Defaults to $XDG_DATA_HOME/aomi/world-markets/pnl or ~/.local/share/aomi/world-markets/pnl
# WORLD_PNL_DIR=/path/to/pnl-ledger

# Dev/CLI account binding for get_world_account lookups (handover overrides on hosted).
# aomi-run stubs the wallet; with this set, read-only account tools use the on-chain owner.
# WORLD_ACCOUNT_ID=17

# Local execution sidecar (scripts/dev-run.sh). The plugin never reads the key.
# WORLD_EXECUTION_URL=http://127.0.0.1:8787
# WORLD_EXECUTION_PORT=8787
# WORLD_PRIVATE_KEY=0x...
# Local policy document. Unset or `placeholder` uses the bundled WETH/USDT example
# (mandate.dev.example.json). A real path loads that file. `none` fail-closes.
# WORLD_MANDATE_PATH=placeholder
# When ATLAS post-trade RAPV cannot be proven (stubbed evm-core), seed it from live RAPV
# so the mandate floor can pass in local aomi-run. Unset in production.
# WORLD_DEV_SEED_POST_TRADE_RAPV=1
# WORLD_SWAP_ROUTER_ADDRESS=
# WORLD_PRICE_HELPER_ADDRESS=
# WORLD_EXECUTION_SLIPPAGE=0.005

# Unsigned brain sidecar (news, watches, history). No private key.
# WORLD_BRAIN_URL=http://127.0.0.1:8788
# WORLD_BRAIN_PORT=8788
# WORLD_BRAIN_DIR=
# WORLD_NEWS_SOURCES=cryptocompare
# WORLD_WATCH_FIRE_CEILING=5
# Optional Node module that default-exports async impact(body) using @composite/sdk.
# WORLD_IMPACT_SDK_MODULE=


# Optional native-yield table (JSON object of symbol → APY decimal string). Missing = null / none.
# Never invent a native yield. Illustrative ETH≈3% / SOL≈7.5% figures are not defaults.
# WORLD_NATIVE_YIELDS={"WETH":"0.03","SOL":"0.075"}
# WORLD_NATIVE_YIELDS_PATH=/path/to/native-yields.json

# Optional carry / loan origination ledger directories (same XDG layout as PnL).
# WORLD_CARRY_DIR=/path/to/carry-ledger
# WORLD_LOAN_DIR=/path/to/loan-origination
# WORLD_NEGATIVE_CARRY_WINDOW_DAYS=3

# --- Mini App (full local stack: ./scripts/dev-full.sh) ---
# TELEGRAM_BOT_TOKEN=
# MINI_APP_BIND=127.0.0.1:8080
# MINI_APP_DEV_BYPASS=1
# WORLD_ACCOUNT_ID is reused for the snapshot (Telegram user → account map is not in this plugin).
# WORLD_TELEGRAM_BOT=WorldMarketsBot
# WORLD_MINI_PRIMARY_VIEW=ledger
# WORLD_MINI_JOBLINE_NEGATIVE=0
# WORLD_MINI_FAMILY=blue
# WORLD_MINI_VOICE_HOME=1
# WORLD_MINI_VOICE_MODE=hold
# WORLD_MINI_LIVE_WORDS=1
# Hold-to-talk STT (Deepgram applies F11 keyterms; Whisper transcribes without boost):
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=

# --- The Desk (leftover Vite rehearsal client; Mini App voice does not call it) ---
# DESK_URL=http://127.0.0.1:8765
# DESK_CONTEXT_URL=http://127.0.0.1:8080
# DESK_BRIDGE_TOKEN=

# --- Market charts (local PNG; hosted Telegram sendPhoto is a later host concern) ---
WORLD_MARKET_DATA_FEED=yahoo
# WORLD_UNIVERSE_DIR=
# WORLD_UNIVERSE_TTL_SECS=86400
# WORLD_CHART_DIR=
WORLD_CHART_OPEN=1
# WORLD_CHART_KEEP=3
# WORLD_CHART_TTL_SECS=3600
# Later: MARKET_DATA_API_KEY=
