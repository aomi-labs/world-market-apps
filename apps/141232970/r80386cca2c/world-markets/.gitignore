.env
.env.*
!.env.example

# Local Aomi deployment lifecycle state
/.aomi/deployment.json

# Execution sidecar
/sidecar/node_modules/

# Brain sidecar (unsigned news / watches)
/brain/node_modules/


# The Desk (voice client) local runtime
/desk/.venv/
/desk/.env
/desk/data/
/desk/client/node_modules/
/desk/client/dist/
/desk/**/__pycache__/
/desk/**/.pytest_cache/
